{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zuse-web-solid",
  "compatibility_date": "2026-11-01",
  "main": "cloudflare/worker.js",
  "assets": {
    "directory": "../../dist/web-solid",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
