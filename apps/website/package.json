{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "node scripts/generate-website-changelog.mjs && next dev --port 3001",
		"build": "node scripts/generate-website-changelog.mjs && next build --webpack",
		"start": "next start --port 3001",
		"lint": "eslint",
		"content:generate": "fumadocs-mdx",
		"check-types": "node scripts/generate-website-changelog.mjs && bun run content:generate && tsc --noEmit",
		"test": "node scripts/generate-website-changelog.mjs && vitest run",
		"test:unit": "node scripts/generate-website-changelog.mjs && vitest run",
		"test:dither-browser": "node test/dither-editor.browser.mjs",
		"changelog:generate": "node scripts/generate-website-changelog.mjs",
		"cf:build": "opennextjs-cloudflare build",
		"cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 8787",
		"cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
	},
	"dependencies": {
		"@base-ui/react": "^1.5.0",
		"@fontsource-variable/geist": "^5.2.8",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@fontsource/anton": "^5.3.0",
		"@fontsource/dm-mono": "^5.3.0",
		"@hugeicons/react": "^1.1.7",
		"@opennextjs/cloudflare": "1.20.19",
		"@pierre/diffs": "1.3.3",
		"@repo/ui": "workspace:*",
		"@tabler/icons-react": "^3.36.0",
		"@tailwindcss/typography": "^0.5.20",
		"@types/mdx": "^2.0.13",
		"@zuse/analytics": "workspace:*",
		"@zuse/i18n": "workspace:*",
		"@zuse/icons": "workspace:*",
		"clsx": "^2.1.1",
		"fumadocs-core": "16.10.4",
		"fumadocs-mdx": "15.0.12",
		"fumadocs-ui": "16.10.4",
		"lucide-react": "^1.16.0",
		"motion": "^12.23.24",
		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"posthog-js": "^1.406.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shadcn": "^4.8.0",
		"svg-dotted-map": "^2.0.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.6",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "4.1.10",
		"wrangler": "^4.168.0"
	},
	"workspaces": [
		"packages/*"
	]
}
