{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zuse-docs",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-20",
	"assets": {
		"directory": "out",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/*",
			"!/_next/*",
			"!/api/search",
			"!/brand/*",
			"!/logos/*",
			"!/screenshots/*",
			"!/app-icon.png",
			"!/og.png",
			"!/openapi.json",
			"!/llms.txt",
			"!/llms-full.txt",
			"!/robots.txt",
			"!/sitemap.xml"
		]
	},
	"observability": {
		"enabled": true
	}
}
