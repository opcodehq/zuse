# The native x86_64 binary is built/tested away from the small deployment host.
# The build context holds `zuse-cloud-api` plus `host.mjs` and `runtime.mjs` from
# packages/executor-v2/vendor/ (the plugin worker, run under the pinned Bun).
FROM oven/bun:1.3.10 AS executor-runtime
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home zuse \
    && install -d -o 10001 -g 10001 -m 700 /var/lib/zuse/recovery
COPY zuse-cloud-api /usr/local/bin/zuse-cloud-api
COPY --from=executor-runtime /usr/local/bin/bun /usr/local/bin/bun
COPY host.mjs runtime.mjs /opt/zuse/executor/vendor/
RUN chmod 0555 /usr/local/bin/zuse-cloud-api /usr/local/bin/bun && chmod 0444 /opt/zuse/executor/vendor/*.mjs
USER 10001:10001
ENV ZUSE_CLOUD_LISTEN=0.0.0.0:8080
ENV ZUSE_CLOUD_EXECUTOR_SCRIPT=/opt/zuse/executor/vendor/host.mjs
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/zuse-cloud-api"]
CMD ["serve"]
