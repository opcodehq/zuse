# The native x86_64 binary is built/tested away from the small deployment host.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home zuse \
    && install -d -o 10001 -g 10001 -m 700 /var/lib/zuse/recovery
COPY zuse-cloud-api /usr/local/bin/zuse-cloud-api
RUN chmod 0555 /usr/local/bin/zuse-cloud-api
USER 10001:10001
ENV ZUSE_CLOUD_LISTEN=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/zuse-cloud-api"]
CMD ["serve"]
