#!/bin/sh
set -eu
zuse-monitor start
umask 077
password_file="$HOME/.local/state/zuse-monitor/vnc-password"
python3 -c 'import secrets; print(secrets.token_urlsafe(6))' > "$password_file"
exec x11vnc -display "$DISPLAY" -auth "$XAUTHORITY" -rfbport 5900 -passwdfile "$password_file" -forever -shared -noxdamage
